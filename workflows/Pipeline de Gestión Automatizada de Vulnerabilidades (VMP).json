      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO vulnerabilities_ignored \n(package_name, ecosystem, vulnerable_range, patched_version, ignored_at, hit_count)\nVALUES (\n  '{{ $json.vulnerabilities.package.name }}', \n  '{{ $json.vulnerabilities.package.ecosystem }}', \n  '{{ $json.vulnerabilities.vulnerable_version_range }}', \n  '{{ $json.first_patched_version || \"N/A\" }}',\n  NOW(),\n  1\n)\nON CONFLICT (package_name, vulnerable_range) \nDO UPDATE SET \n    ignored_at = NOW(),\n    hit_count = vulnerabilities_ignored.hit_count + 1;",
