    {
      "parameters": {
        "jsCode": "// 1. Obtener catálogo de CISA KEV\nconst cisaNodeData = $('Fetch_CISA_KEV').first().json;\nconst cisaCatalog = cisaNodeData.vulnerabilities || [];\n\nreturn items.map(inputItem => {\n    const item = inputItem.json;\n    \n    // --- 1. LÓGICA DE VERSIONES (Filtro inicial) ---\n    const vData = item.vulnerabilities || {};\n    const miVersion = item.version || \"0.0.0\"; // Viene de tu DB\n    const parcheVersion = vData.first_patched_version;\n    \n    let esVulnerableReal = true;\n\n    // Solo descartamos si la versión instalada es igual o mayor a la parcheada\n    if (parcheVersion && miVersion !== \"0.0.0\") {\n        if (miVersion.localeCompare(parcheVersion, undefined, { numeric: true }) >= 0) {\n            esVulnerableReal = false; \n        }\n    }\n\n    if (!esVulnerableReal) return null;\n\n    // --- 2. EXTRACCIÓN DE CVSS ---\n    const cvssScore = parseFloat(\n        item.cvss_severities?.cvss_v4?.score || \n        item.cvss_severities?.cvss_v3?.score || \n        0.0\n    );\n\n    const idGhsa = item.ghsa_id || \"N/A\";\n    const idCve = item.cve_id || \"N/A\";\n\n    // --- 3. MATCH CISA KEV ---\n    const cisaMatch = (idCve !== \"N/A\") \n        ? cisaCatalog.find(v => v.cveID && v.cveID.trim().toUpperCase() === idCve.trim().toUpperCase())\n        : null;\n    const esExplotado = !!cisaMatch;\n\n    // --- 4. LÓGICA DE PRIORIDAD (COHERENTE) ---\n    let prioridadFinal = \"LOW\";\n    \n    // Nivel 1: Por Score CVSS\n    if (cvssScore >= 7.0) {\n        prioridadFinal = \"HIGH\";\n    } else if (cvssScore >= 4.0) {\n        prioridadFinal = \"MEDIUM\";\n    }\n\n    // Nivel 2: Por ausencia de Parche (Zero-Day escala a CRITICAL)\n    if (!parcheVersion) {\n        prioridadFinal = \"CRITICAL\";\n    }\n\n    // Nivel 3: Por CISA KEV (Explotación activa escala a CRITICAL)\n    if (esExplotado) {\n        prioridadFinal = \"CRITICAL\";\n    }\n\n    // --- 5. ACTION PLAN ---\n    let plan = \"\";\n    if (esExplotado) {\n        plan = `🚨 EMERGENCIA: Vulnerabilidad explotada activamente (CISA KEV). AISLAR el activo '${item.name}' y aplicar parche v${parcheVersion || 'urgente'} de forma inmediata.`;\n    } else if (prioridadFinal === \"CRITICAL\" && !parcheVersion) {\n        plan = `💀 RIESGO CRÍTICO (Zero-Day): No hay parche disponible para el software '${vData.package?.name}'. Incrementar monitoreo de logs y restringir acceso al activo. CVSS: ${cvssScore}`;\n    } else if (prioridadFinal === \"HIGH\") {\n        plan = `⚠️ ALERTA: Riesgo alto detectado. Score CVSS: ${cvssScore}. Se requiere programar actualización a v${parcheVersion} en la próxima ventana de mantenimiento.`;\n    } else {\n        plan = `🔍 OBSERVACIÓN: Riesgo ${prioridadFinal.toLowerCase()} (${cvssScore}). Verificar compatibilidad con la versión parcheada v${parcheVersion}.`;\n    }\n\n    return {\n        json: {\n            asset_id: item.id,\n            asset_name: item.name,\n            software: vData.package?.name || item.software || \"Desconocido\",\n            version_instalada: miVersion,\n            ghsa_id: idGhsa,\n            cve_id: idCve,\n            cvss: cvssScore,\n            priority: prioridadFinal,\n            is_cisa_kev: esExplotado,\n            action_plan: plan,\n            processed_at: new Date().toISOString()\n        }\n    };\n}).filter(x => x !== null);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        -160
      ],
      "id": "4a5f1faf-0ff7-44b9-9c24-f6eaef9c476c",
      "name": "Risk_Assessment_Engine"
