        "jsCode": "const allItems = items;\n\nlet metrics = {\n    total_items: allItems.length,\n    auditados: 0,\n    ignorados: 0,\n    criticos: 0,\n    altas: 0,\n    medias: 0,\n    bajas: 0\n};\n\nfor (const item of allItems) {\n    const data = item.json;\n\n    // Buscamos el valor de criticidad en cualquier variante de nombre\n    // Esto cubre 'criticality', 'Criticality', 'PRIORITY', etc.\n    const rawCriticality = data.criticality || data.Criticality || data.priority || data.Priority || null;\n\n    // Si encontramos una criticidad definida, es un auditado\n    if (rawCriticality !== null) {\n        metrics.auditados++;\n        \n        const sev = rawCriticality.toString().toUpperCase();\n        \n        if (sev === 'CRITICAL') metrics.criticos++;\n        else if (sev === 'HIGH') metrics.altas++;\n        else if (sev === 'MEDIUM') metrics.medias++;\n        else if (sev === 'LOW') metrics.bajas++;\n    } \n    // Si no tiene nada de eso, verificamos si es de la rama de ignorados (JSON de GitHub)\n    else {\n        metrics.ignorados++;\n    }\n}\n\nreturn [{\n    json: {\n        ejecucion_stats: {\n            resumen: `Análisis finalizado: ${metrics.total_items} registros evaluados.`,\n            detalle: metrics,\n            status_sistema: metrics.criticos > 0 ? \"⚠️ ACCIÓN REQUERIDA\" : \"✅ ESTABLE\",\n            fecha: new Date().toLocaleString()\n        }\n    }\n}];"
      },
