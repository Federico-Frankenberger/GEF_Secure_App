    {
      "parameters": {
        "jsCode": "// 1. Recolectamos todos los paquetes válidos de los 100 resultados\nconst validPool = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // Verificamos que tenga la estructura de GitHub Advisories\n  if (data.vulnerabilities && Array.isArray(data.vulnerabilities)) {\n    // Buscamos dentro de ese advisory si hay un paquete con nombre y ecosistema\n    const found = data.vulnerabilities.find(v => v.package?.name && v.package?.ecosystem);\n    \n    if (found) {\n      validPool.push({\n        summary: data.summary,\n        severity: data.severity,\n        packageName: found.package.name,\n        ecosystem: found.package.ecosystem\n      });\n    }\n  }\n}\n\n// 2. Si la API no devolvió nada válido, tiramos un array vacío (evita que el flujo explote)\nif (validPool.length === 0) return [];\n\n// 3. SELECCIÓN ALEATORIA: Elegimos uno al azar del pool de 100\nconst selected = validPool[Math.floor(Math.random() * validPool.length)];\n\n// 4. Devolvemos el formato exacto que espera tu SQL (Nodo 3)\nreturn [{\n  json: {\n    name: `[TEST] - ${selected.packageName.toUpperCase()} - Simulación de Activo`,\n    software: selected.packageName,\n    ecosystem: selected.ecosystem,\n    version: \"0.0.1\", // Versión fija para forzar el match de riesgo en la tesis\n    criticality: selected.severity || \"critical\",\n    last_scan: new Date().toISOString(),\n    description: \"Inyección aleatoria - Test de consistencia GEF Secure\"\n  }\n}];"
      },
