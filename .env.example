# =====================================================================
# GEF Secure — variables de entorno
# Copiar a .env y completar. Ver GEF_Secure_Automatizacion_n8n.pdf
# seccion 8 para el detalle de cada variable (obligatoriedad, seguridad).
# =====================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_DB=security
POSTGRES_USER=security_user
POSTGRES_PASSWORD=cambia-esto-por-una-clave-fuerte

# ── pgAdmin ────────────────────────────────────────────────────────────
# pgAdmin valida el formato del email estrictamente y rechaza dominios
# reservados como .local (verificado: "special-use or reserved name").
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=cambia-esto-tambien

# ── n8n: imagen y arranque ────────────────────────────────────────────
N8N_VERSION=2.4.6

# Generar una sola vez con: openssl rand -base64 32
# No volver a cambiarla una vez que n8n ya tiene credenciales guardadas.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=America/Argentina/Mendoza
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_PUBLIC_URL=http://localhost:5678/

# ── n8n: owner (se crea via POST /rest/owner/setup, password en texto
# plano — no requiere hash, ver PDF seccion 4.2) ──────────────────────
N8N_OWNER_EMAIL=admin@gef-secure.local
N8N_OWNER_FIRST_NAME=GEF
N8N_OWNER_LAST_NAME=Secure
N8N_OWNER_PASSWORD=cambia-esta-clave-tambien

# ── n8n: credenciales usadas por el workflow ──────────────────────────
# Token del bot de Slack (nodos de notificacion)
SLACK_BOT_TOKEN=

# Personal Access Token de GitHub (GitHub Advisory API — sube el rate
# limit de 60 a 5000 req/h). Recomendado, no bloqueante si se deja vacio.
GITHUB_TOKEN=

# ── Backend ────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
