# Muestra el bloque de "acceso rápido (demo)" en el login (4 botones que loguean
# directo con un usuario de cada rol, incluido ADMIN, sin pedir contraseña real).
# Dejar en 'true' SOLO en builds de demo/desarrollo -- nunca en un build de
# producción real (ver docs/adr para el criterio de "proyecto en camino a
# producto comercial"). Se lee en build time (Vite), no en runtime.
VITE_ENABLE_DEMO_LOGIN=true
